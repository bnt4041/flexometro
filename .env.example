# Copiar a .env antes de levantar el stack.

# --- Base de datos ---
POSTGRES_USER=obras
POSTGRES_PASSWORD=obras_dev_password
POSTGRES_DB=obras
POSTGRES_PORT=5432

# Rol de mínimo privilegio con el que se conecta la API (sin SUPERUSER, sin
# BYPASSRLS): lo crea la migración core_0003 usando el rol admin de arriba.
# Es obligatorio darle una contraseña propia, distinta de la del admin.
APP_DB_USER=obras_app
APP_DB_PASSWORD=obras_app_dev_password

# --- API ---
API_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# --- Autenticación ---
# keycloak: valida el JWT contra el realm (lo normal desde la Fase 6).
# stub: principal fijo, sin autenticación. Útil para pruebas y scripts.
AUTH_BACKEND=keycloak
STUB_ORGANIZATION_SLUG=demo

# URL interna (API -> Keycloak, dentro de la red de Docker) y pública
# (navegador -> Keycloak). El emisor del token lleva la pública, así que la API
# acepta ambas como válidas.
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_REALM=obras
KEYCLOAK_CLIENT_ID=obras-api
KEYCLOAK_WEB_CLIENT_ID=obras-web
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- IA (DeepSeek) ---
# Proveedor fijo de IA de este stack. Vacío por defecto: el módulo `ia`
# responde 503 en vez de fallar a medias. Solo se le envía vocabulario
# estructural (tipos de obra, resúmenes, unidades) — nunca precios ni datos
# de cliente.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini: solo para lo que necesita visión (lectura de planos). La imagen del
# plano sí sale hacia este proveedor externo, a diferencia de DeepSeek.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Gestor documental (MinIO, self-hosted, Fase 30) ---
# Proveedor fijo de almacenamiento de este stack, igual que DeepSeek/Gemini
# para IA. El bucket se crea solo al arrancar la API si no existe.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=obras
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=documentos

# --- Frontend ---
WEB_PORT=5173

# --- Traefik (perfil "proxy", no se usa en desarrollo local) ---
TRAEFIK_DOMAIN=obras.localhost
